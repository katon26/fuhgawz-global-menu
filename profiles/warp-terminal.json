{
  "id": "warp-terminal",
  "match": {
    "wm_class": ["warp-terminal", "warp", "Warp", "dev.warp.Warp"],
    "app_id": ["warp-terminal.desktop", "warp.desktop", "dev.warp.Warp.desktop"]
  },
  "app_menu": {
    "label": "Warp",
    "items": [
      { "label": "About Warp", "action": "about", "shortcut": "" },
      { "label": "Settings", "shortcut": "Ctrl+," },
      { "type": "separator" },
      { "label": "Hide Warp", "action": "hide" },
      { "type": "separator" },
      { "label": "Quit Warp", "shortcut": "Ctrl+Q" }
    ]
  },
  "menus": [
    {
      "label": "Shell",
      "items": [
        { "label": "New Tab", "shortcut": "Ctrl+Shift+T" },
        { "label": "New Window", "shortcut": "Ctrl+Shift+N" },
        { "label": "Split Pane Right", "shortcut": "Ctrl+Shift+D" },
        { "label": "Split Pane Down", "shortcut": "Ctrl+Shift+E" },
        { "type": "separator" },
        { "label": "Close Tab", "shortcut": "Ctrl+Shift+W" },
        { "label": "Close Window", "shortcut": "Ctrl+Shift+Q" }
      ]
    },
    {
      "label": "Edit",
      "items": [
        { "label": "Copy", "shortcut": "Ctrl+Shift+C" },
        { "label": "Paste", "shortcut": "Ctrl+Shift+V" },
        { "type": "separator" },
        { "label": "Select All", "shortcut": "Ctrl+Shift+A" },
        { "label": "Find...", "shortcut": "Ctrl+Shift+F" },
        { "type": "separator" },
        { "label": "Clear Screen", "shortcut": "Ctrl+L" }
      ]
    },
    {
      "label": "View",
      "items": [
        { "label": "Zoom In", "shortcut": "Ctrl++" },
        { "label": "Zoom Out", "shortcut": "Ctrl+-" },
        { "label": "Actual Size", "shortcut": "Ctrl+0" },
        { "type": "separator" },
        { "label": "Toggle Full Screen", "shortcut": "F11" },
        { "label": "Command Palette", "shortcut": "Ctrl+Shift+P" }
      ]
    },
    {
      "label": "Window",
      "items": [
        { "label": "Minimize", "action": "hide" },
        { "type": "separator" },
        { "label": "Next Tab", "shortcut": "Ctrl+Page_Down" },
        { "label": "Previous Tab", "shortcut": "Ctrl+Page_Up" }
      ]
    },
    {
      "label": "Help",
      "items": [
        { "label": "About Warp", "action": "about", "shortcut": "" }
      ]
    }
  ]
}
